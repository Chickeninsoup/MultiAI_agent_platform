# Execution mode:
# - simulated: deterministic local executor
# - llm: real language model execution
EXECUTION_MODE=simulated

# LLM provider
LLM_PROVIDER=anthropic

# Anthropic configuration
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Shared LLM runtime settings
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# Tool-calling loop limits (llm mode only)
LLM_MAX_TOOL_ROUNDS=8
LLM_MAX_TOTAL_TOKENS=100000

# When true, events.jsonl records each tool call's full output (not just
# output_chars/truncated). Off by default: full output can be large and
# may contain source code or other repository contents.
DEBUG_LOG_FULL_OUTPUT=false

# Path (relative to project_root) to the run_test command whitelist.
# Not agent-specific — it defines what commands exist, tool-policy.json
# controls which agents may call run_test at all.
TEST_POLICY_PATH=src/config/test_policy.json
