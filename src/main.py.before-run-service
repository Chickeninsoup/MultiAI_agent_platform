import argparse

from datetime import datetime, timezone
from pathlib import Path

from src.repositories import RunRepository, TaskRepository

PROJECT_ROOT = Path(__file__).resolve().parent.parent
TASKS_DIR = PROJECT_ROOT / "tasks"

task_repository = TaskRepository(TASKS_DIR)
run_repository = RunRepository(TASKS_DIR)


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(
        "+00:00", "Z"
    )


def execute_run(task_id: str) -> None:
    task = task_repository.load(task_id)
    run_id = task.get("current_run_id")

    if not run_id:
        raise ValueError(f"Task {task_id} has no current_run_id")

    run = run_repository.load(task_id, run_id)

    if run.get("status") == "completed":
        raise ValueError(f"Run {run_id} has already been completed")

    run_input = run_repository.read_input(task_id, run_id)

    output = (
        "# Run Output\n\n"
        f"Run `{run_id}` completed successfully.\n\n"
        f"Agent: `{run['agent_id']}`\n\n"
        "## Input Received\n\n"
        f"{run_input}\n"
    )

    run_repository.write_output(task_id, run_id, output)
    summary = (
   	 "# Run Summary\n\n"
   	 f"- Run ID: `{run_id}`\n"
  	 f"- Agent ID: `{run['agent_id']}`\n"
   	 "- Status: `completed`\n"
   	 "- Summary: The initial task execution workflow completed successfully.\n"
   	 "- Important findings: Task and Run metadata can be read and updated.\n"
   	 "- Decisions made: Continue using file-based JSON metadata for the prototype.\n"
   	 "- Remaining work: Append this summary to the Task background.\n"
	)

    run_repository.write_summary(task_id, run_id, summary)

    completed_at = utc_now()

    run["status"] = "completed"
    run["updated_at"] = completed_at
    run["completed_at"] = completed_at
    run_repository.save(task_id, run_id, run)

    task["updated_at"] = completed_at
    task_repository.save(task_id, task)

    print(f"Completed run: {run_id}")
    print(
    "Output written to: "
    f"{run_repository.get_output_file(task_id, run_id)}"
    )


def list_tasks() -> None:
    tasks = task_repository.list_all()

    if not tasks:
        print("No tasks found.")
        return

    for task in tasks:
        task_id = task.get("id", "unknown")
        title = task.get("title", "Untitled")
        status = task.get("status", "unknown")
        current_run_id = task.get("current_run_id")

        print(
            f"{task_id} | "
            f"{status} | "
            f"{current_run_id or '-'} | "
            f"{title}"
        )

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Manage tasks and runs in the AI agent platform."
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
	 "list",
	help="List all tasks.",
    )

    run_parser = subparsers.add_parser(
        "run",
        help="Execute the current run for a task.",
    )

    run_parser.add_argument(
        "task_id",
        help="Task ID, for example task-20260713-001.",
    )

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    try:
         if args.command == "list":
             list_tasks()
         elif args.command == "run":
             execute_run(args.task_id)
    except (FileNotFoundError, ValueError, KeyError) as error:
        parser.exit(status=1, message=f"Error: {error}\n")


if __name__ == "__main__":
    main()
