from dataclasses import replace
from datetime import datetime, timezone

from src.repositories import (
    AgentRepository,
    RunRepository,
    TaskRepository,
)


def utc_now() -> str:
    return (
        datetime.now(timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


class RunService:
    def __init__(
        self,
        task_repository: TaskRepository,
        run_repository: RunRepository,
        agent_repository: AgentRepository,
    ) -> None:
        self._task_repository = task_repository
        self._run_repository = run_repository
        self._agent_repository = agent_repository

    def execute(self, task_id: str) -> None:
        task = self._task_repository.load(task_id)
        run_id = task.current_run_id

        if not run_id:
            raise ValueError(
                f"Task {task_id} has no current_run_id"
            )

        run = self._run_repository.load(task_id, run_id)

        if run.is_completed():
            raise ValueError(
                f"Run {run_id} has already been completed"
            )

        if run.task_id != task.id:
            raise ValueError(
                f"Run {run.id} belongs to task "
                f"{run.task_id}, not {task.id}"
            )

        if not task.is_agent_assigned(run.agent_id):
            raise ValueError(
                f"Agent {run.agent_id} is not assigned "
                f"to task {task.id}"
            )

        agent = self._agent_repository.load(run.agent_id)

        if agent.status != "ready":
            raise ValueError(
                f"Agent {agent.id} is not ready"
            )

        run_input = self._run_repository.read_input(
            task.id,
            run.id,
        )

        output = self._build_output(
            run_id=run.id,
            agent_id=agent.id,
            run_input=run_input,
        )

        summary = self._build_summary(
            run_id=run.id,
            agent_id=agent.id,
        )

        self._run_repository.write_output(
            task.id,
            run.id,
            output,
        )

        self._run_repository.write_summary(
            task.id,
            run.id,
            summary,
        )

        completed_at = utc_now()

        completed_run = replace(
            run,
            status="completed",
            updated_at=completed_at,
            completed_at=completed_at,
        )

        updated_task = replace(
            task,
            updated_at=completed_at,
        )

        self._run_repository.save(completed_run)
        self._task_repository.save(updated_task)

        output_file = self._run_repository.get_output_file(
            task.id,
            run.id,
        )

        print(f"Completed run: {run.id}")
        print(f"Output written to: {output_file}")

    @staticmethod
    def _build_output(
        run_id: str,
        agent_id: str,
        run_input: str,
    ) -> str:
        return (
            "# Run Output\n\n"
            f"Run `{run_id}` completed successfully.\n\n"
            f"Agent: `{agent_id}`\n\n"
            "## Input Received\n\n"
            f"{run_input}\n"
        )

    @staticmethod
    def _build_summary(
        run_id: str,
        agent_id: str,
    ) -> str:
        return (
            "# Run Summary\n\n"
            f"- Run ID: `{run_id}`\n"
            f"- Agent ID: `{agent_id}`\n"
            "- Status: `completed`\n"
            "- Summary: The initial task execution workflow "
            "completed successfully.\n"
            "- Important findings: Task and Run metadata "
            "can be read and updated.\n"
            "- Decisions made: Continue using file-based "
            "JSON metadata for the prototype.\n"
            "- Remaining work: Append this summary to the "
            "Task background.\n"
        )
